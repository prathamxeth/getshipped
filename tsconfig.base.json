{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@getshipped/shared-types": ["./packages/shared-types/src"],
      "@getshipped/shared-types/*": ["./packages/shared-types/src/*"],
      "@getshipped/remotion-studio": ["./packages/remotion-studio/src"],
      "@getshipped/remotion-studio/*": ["./packages/remotion-studio/src/*"]
    }
  },
  "exclude": ["node_modules"]
}
